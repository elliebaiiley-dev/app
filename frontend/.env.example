# Frontend environment variables.
#
# Set these in your hosting dashboard (Vercel → Project Settings → Environment Variables).
# Any variable prefixed with EXPO_PUBLIC_ is baked into the client bundle at build time
# (it is readable by every visitor — never put secrets here).

# Full HTTPS URL of your deployed FastAPI backend. NO trailing slash.
# Example (Railway):  https://petadmin-api.up.railway.app
# Example (Render):   https://petadmin-api.onrender.com
# Example (own API subdomain): https://api.petadmin.co.uk
EXPO_PUBLIC_BACKEND_URL=
