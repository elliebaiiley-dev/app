# Backend environment variables.
#
# Set these in your hosting dashboard (Railway / Render / Fly.io / etc.).
# NEVER commit real values — this file is a template only.
# The real `.env` file is git-ignored.

# ---- Database ----
# MongoDB connection string. Use MongoDB Atlas free tier for production:
# mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=
# Database name (any string, e.g. "petadmin")
DB_NAME=petadmin

# ---- Auth ----
# REQUIRED. The app refuses to boot if this is empty or shorter than 32 chars.
# Rotate this = everyone must log in again.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---- CORS ----
# Comma-separated list of allowed frontend origins (no trailing slash).
# Example: https://petadmin.co.uk,https://www.petadmin.co.uk
# Use "*" only during local development.
CORS_ALLOWED_ORIGINS=*

# ---- Pet photos (optional) ----
# Emergent-managed object storage. Only set if you continue to use Emergent
# as the file-hosting layer. Otherwise swap `_put_object_sync` in server.py
# for your own S3/R2 code — see DEPLOY.md.
EMERGENT_LLM_KEY=

# ---- Stripe (£12.99/month subscription) ----
# Test keys for staging, live keys for production.
STRIPE_API_KEY=sk_test_or_sk_live_from_stripe_dashboard
# REQUIRED for the /api/stripe/webhook endpoint. If this is empty the webhook
# endpoint returns 503 — this prevents forged events from flipping any
# business to "paid". See DEPLOY.md step 5 for how to obtain it.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AMOUNT_GBP=1299
STRIPE_TRIAL_DAYS=14
